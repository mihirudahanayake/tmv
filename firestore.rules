rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSiteAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == 'mihirumilanka11@gmail.com';
    }

    function myUserDoc() {
      return signedIn()
        ? (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
              ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
              : {}
          )
        : {};
    }

    function myRole() {
      return isSiteAdmin()
        ? 'siteAdmin'
        : (myUserDoc().get('role', null) != null)
          ? myUserDoc().get('role', null)
          : (myUserDoc().get('userType', null) == 'admin')
            ? 'departmentHead'
            : (myUserDoc().get('userType', null) == 'superAdmin')
              ? 'superAdmin'
            : (myUserDoc().get('userType', null) == 'supervisor'
              || myUserDoc().get('userType', null) == 'supervisorTO')
                ? 'supervisorTO'
                : 'member';
    }

    function isSuperAdmin() {
      return signedIn() && (
        myUserDoc().get('role', null) == 'superAdmin'
        || myUserDoc().get('userType', null) == 'superAdmin'
      );
    }

    function isDeptHead() {
      return signedIn() && myRole() == 'departmentHead';
    }

    function isSupervisorTO() {
      return signedIn() && (myRole() == 'supervisorTO' || myUserDoc().isTO == true);
    }

    function isCupboardCardScanner() {
      return signedIn() && (
        myUserDoc().get('role', null) == 'superAdmin'
        || myUserDoc().get('userType', null) == 'superAdmin'
        || myUserDoc().get('role', null) == 'supervisorTO'
        || myUserDoc().get('userType', null) in ['supervisor', 'supervisorTO']
        || myUserDoc().get('isTO', false) == true
      );
    }

    function myDepartments() {
      return (myUserDoc().departments is list)
        ? myUserDoc().departments
        : (myUserDoc().department != null)
          ? [myUserDoc().department]
          : [];
    }

    function departmentsFromUserData(d) {
      return (d.departments is list)
        ? d.departments
        : (d.department != null)
          ? [d.department]
          : [];
    }

    function myManagedDepartments() {
      return isDeptHead()
        ? (
            (myUserDoc().managedDepartments is list && myUserDoc().managedDepartments.size() > 0)
              ? myUserDoc().managedDepartments
              : (myUserDoc().firstPriority != null)
                ? [myUserDoc().firstPriority]
                : (myUserDoc().departments is list && myUserDoc().departments.size() > 0)
                  ? [myUserDoc().departments[0]]
                  : []
          )
        : [];
    }

    function workDept(res) {
      // Legacy fallback: missing department treated as videography
      return (res.data.department != null) ? res.data.department : 'videography';
    }

    function allowedWorkDepts() {
      // Keep in sync with src/constants/workDepartments.js
      return ['videography', 'photography', 'graphic_design', 'announcing', 'content_writing', 'editing'];
    }

    function isValidWorkDept(dept) {
      return dept != null && allowedWorkDepts().hasAny([dept]);
    }

    function isValidWorkDeptList(listVal) {
      return (listVal is list)
        && listVal.size() > 0
        && listVal.size() <= 10
        && listVal.hasOnly(allowedWorkDepts());
    }

    function isValidUsername(username) {
      return username is string
        && username.size() >= 3
        && username.size() <= 20
        && username.matches('^[A-Za-z0-9_]+( [A-Za-z0-9_]+)*$');
    }

    function preservesUsername() {
      return request.resource.data.get('username', null) == resource.data.get('username', null)
        && (
          resource.data.get('username', null) == null
          || request.resource.data.get('name', null) == resource.data.get('name', null)
        );
    }

    function hasValidUsernameAfterChange() {
      return isValidUsername(request.resource.data.get('username', null))
        && request.resource.data.get('name', null)
          == request.resource.data.get('username', null);
    }

    function changedProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function profileFieldChanged(field) {
      return changedProfileFields().hasAny([field]);
    }

    function profileUpdateFieldsAreAllowed() {
      return changedProfileFields().hasOnly([
        'username',
        'name',
        'fullName',
        'phoneNo',
        'birthday',
        'gender',
        'registrationNumber',
        'batch',
        'studyDepartment',
        'cardNumber',
        'NFC_card_id',
        'departments',
        'firstPriority',
        'department',
        'photoURL',
        'email',
        'fcmToken',
        'fcmTokens'
      ]);
    }

    function ownProfileIsDepartmentHead() {
      return resource.data.get('role', null) == 'departmentHead'
        || resource.data.get('userType', null) == 'admin';
    }

    function canManageDept(dept) {
      return isDeptHead() && myManagedDepartments().hasAny([dept]);
    }

    function canReadUserDoc(targetUserId, targetData) {
      return signedIn() && (
        isSiteAdmin()
        || isSuperAdmin()
        || targetUserId == request.auth.uid
        || (
          isDeptHead() && (
            (targetData.get('departments', null) is list
              && targetData.get('departments', []).hasAny(myManagedDepartments()))
            || (
              !(targetData.get('departments', null) is list)
              && targetData.get('department', null) != null
              && myManagedDepartments().hasAny([targetData.get('department', null)])
            )
          )
        )
        || (
          !isDeptHead()
          && myDepartments().hasAny(departmentsFromUserData(targetData))
        )
      );
    }

    match /users/{userId} {
      allow read: if canReadUserDoc(userId, resource.data)
        || (
          isCupboardCardScanner()
          && resource.data.get('NFC_card_id', null) is string
        );

      // Site admin can manage roles/departments.
      allow update: if isSiteAdmin() && preservesUsername();

      // Super admin can manage user details across the system, but cannot create/promote site admins.
      allow update: if isSuperAdmin()
        && resource.data.role != 'siteAdmin'
        && request.resource.data.role != 'siteAdmin'
        && preservesUsername();

      // Members can create only their own basic profile.
      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.role == 'member'
        && request.resource.data.userType == 'user'
        && isValidUsername(request.resource.data.username)
        && request.resource.data.name == request.resource.data.username
        && request.resource.data.birthday is string
        && request.resource.data.birthday.size() > 0
        && request.resource.data.gender in ['male', 'female']
        && isValidWorkDeptList(request.resource.data.departments);

      // Department heads can create member profiles within their managed department.
      allow create: if isDeptHead()
        && request.resource.data.role == 'member'
        && request.resource.data.userType == 'user'
        && request.resource.data.isTO != true
        && (request.resource.data.departments is list)
        && myManagedDepartments().hasAny(request.resource.data.departments)
        && request.resource.data.departments.hasOnly(myManagedDepartments())
        && (
          request.resource.data.firstPriority == null
          || myManagedDepartments().hasAny([request.resource.data.firstPriority])
        )
        && (
          request.resource.data.department == null
          || myManagedDepartments().hasAny([request.resource.data.department])
        );

      // Users can update their own profile but cannot change role or departments.
      allow update: if signedIn() && userId == request.auth.uid
        && profileUpdateFieldsAreAllowed()
        && (preservesUsername() || hasValidUsernameAfterChange())
        && (
        !ownProfileIsDepartmentHead()
          || !changedProfileFields().hasAny(['departments', 'firstPriority', 'department'])
        )
        && (
          !profileFieldChanged('departments')
          || isValidWorkDeptList(request.resource.data.get('departments', null))
        )
        && (
          !profileFieldChanged('firstPriority')
          || request.resource.data.get('firstPriority', null) == null
          || isValidWorkDept(request.resource.data.get('firstPriority', null))
        )
        && (
          !profileFieldChanged('department')
          || request.resource.data.get('department', null) == null
          || isValidWorkDept(request.resource.data.get('department', null))
        );

      // Department heads can update users in their managed department, but cannot grant elevated roles.
      allow update: if isDeptHead()
        && preservesUsername()
        && myManagedDepartments().hasAny(departmentsFromUserData(resource.data))
        && resource.data.role == 'member'
        && resource.data.userType == 'user'
        && request.resource.data.role == 'member'
        && request.resource.data.userType == 'user'
        && request.resource.data.managedDepartments == resource.data.managedDepartments
        && request.resource.data.isTO == resource.data.isTO
        && (request.resource.data.departments is list)
        && (
          request.resource.data.departments == resource.data.departments
          || (
            myManagedDepartments().hasAny(request.resource.data.departments)
            && request.resource.data.departments.hasOnly(myManagedDepartments())
          )
        )
        && (
          request.resource.data.firstPriority == resource.data.firstPriority
          || request.resource.data.firstPriority == null
          || myManagedDepartments().hasAny([request.resource.data.firstPriority])
        )
        && (
          request.resource.data.department == resource.data.department
          || request.resource.data.department == null
          || myManagedDepartments().hasAny([request.resource.data.department])
        );

      allow delete: if false;

      match /notifications/{notifId} {
        allow read: if signedIn() && userId == request.auth.uid;

        // Dept heads (and site admin) can create notifications for users they can read.
        allow create: if (isDeptHead() || isSiteAdmin()) && canReadUserDoc(
          userId,
          get(/databases/$(database)/documents/users/$(userId)).data
        );

        // Users can update their own (e.g., mark read).
        allow update: if signedIn() && userId == request.auth.uid;

        // Admins can edit the content of admin-sent notifications, but cannot change a user's read state.
        allow update: if (isDeptHead() || isSiteAdmin())
          && resource.data.source == 'admin'
          && resource.data.type == 'admin-message'
          && resource.data.broadcastId != null
          && request.resource.data.broadcastId == resource.data.broadcastId
          && request.resource.data.read == resource.data.read
          && (
            isSiteAdmin()
            || (resource.data.senderUid != null && resource.data.senderUid == request.auth.uid)
            || (resource.data.senderId != null && resource.data.senderId == request.auth.uid)
          )
          && canReadUserDoc(
            userId,
            get(/databases/$(database)/documents/users/$(userId)).data
          );
        // Allow deleting only admin-sent broadcast notifications.
        allow delete: if (isDeptHead() || isSiteAdmin())
          && resource.data.source == 'admin'
          && resource.data.type == 'admin-message'
          && resource.data.broadcastId != null
          && (
            isSiteAdmin()
            || (resource.data.senderUid != null && resource.data.senderUid == request.auth.uid)
          )
          && canReadUserDoc(
            userId,
            get(/databases/$(database)/documents/users/$(userId)).data
          );
      }
    }

    match /works/{workId} {
      allow read: if signedIn() && (
        (
          resource.data.assignedUsers is list
          && request.auth.uid in resource.data.assignedUsers
        )
        || isSuperAdmin()
        || canManageDept(workDept(resource))
      );

      allow create: if isDeptHead()
        && request.resource.data.department != null
        && canManageDept(request.resource.data.department);

      // Department heads can fully update works within their department.
      allow update, delete: if canManageDept(workDept(resource));

      // Assigned users can update limited fields (acceptance/completion/rejections) without changing assignment.
      allow update: if signedIn()
        && (resource.data.assignedUsers is list)
        && resource.data.assignedUsers.hasAny([request.auth.uid])
        && request.resource.data.title == resource.data.title
        && request.resource.data.description == resource.data.description
        && request.resource.data.department == resource.data.department
        && request.resource.data.assignedUsers == resource.data.assignedUsers
        && request.resource.data.assignedUserDetails == resource.data.assignedUserDetails
        && request.resource.data.assignedItems == resource.data.assignedItems
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.priority == resource.data.priority
        && request.resource.data.date == resource.data.date
        && request.resource.data.deadline == resource.data.deadline
        && request.resource.data.dateType == resource.data.dateType
        && request.resource.data.status == resource.data.status;
    }

    match /inventory/{itemId} {
      allow read: if signedIn();
      allow write: if isDeptHead() || isSuperAdmin() || isSupervisorTO() || isSiteAdmin();
    }

    match /inventoryUsage/{usageId} {
      allow read: if signedIn() && (
        isSiteAdmin()
        || isSuperAdmin()
        || isDeptHead()
        || isSupervisorTO()
        || resource.data.userId == request.auth.uid
        || (
          resource.data.issuedToUserIds is list
          && resource.data.issuedToUserIds.hasAny([request.auth.uid])
        )
      );

      // Created/updated by inventory managers (Supervisor TO / Super Admin).
      allow create, update: if isSupervisorTO() || isSuperAdmin() || isSiteAdmin();
      allow delete: if false;
    }

    match /cupboardAccessLogs/{recordId} {
      allow read: if isSupervisorTO() || isSuperAdmin();
      allow create: if (isSupervisorTO() || isSuperAdmin())
        && request.resource.data.keys().hasAll([
          'cardUid',
          'scannedByUid',
          'scannedByRole',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'cardUid',
          'scannedByUid',
          'scannedByRole',
          'createdAt'
        ])
        && request.resource.data.cardUid is string
        && request.resource.data.cardUid.size() > 0
        && request.resource.data.scannedByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (
          (isSupervisorTO() && request.resource.data.scannedByRole == 'TO')
          || (isSuperAdmin() && request.resource.data.scannedByRole == 'superAdmin')
        );
      allow update, delete: if false;
    }

    match /accessRecords/{recordId} {
      allow read: if isDeptHead() || isSuperAdmin() || isSiteAdmin() || isSupervisorTO();
      allow create: if isSupervisorTO() || isSuperAdmin() || isSiteAdmin();
      allow update, delete: if false;
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow write: if isDeptHead();
    }

    match /notifications/{notifId} {
      allow read: if isDeptHead() || isSuperAdmin();
      allow create: if signedIn();
      // Site admin can update/delete any notification.
      // Dept heads can:
      // - update/delete activity notifications in their managed departments
      // - update/delete admin-sent broadcasts only if they are the sender
      allow update, delete: if isSiteAdmin()
        || (
          isDeptHead()
          && (
            (
              // Activity notifications (received)
              resource.data.type != 'admin-message'
              && (
                resource.data.department == null
                || canManageDept(resource.data.department)
              )
            )
            || (
              // Admin-sent broadcasts
              resource.data.source == 'admin'
              && resource.data.type == 'admin-message'
              && (
                (resource.data.senderUid != null && resource.data.senderUid == request.auth.uid)
                || (resource.data.senderId != null && resource.data.senderId == request.auth.uid)
              )
              && (
                resource.data.department == null
                || canManageDept(resource.data.department)
              )
              && request.resource.data.department == resource.data.department
            )
          )
        );
    }

    match /rejectedWorks/{id} {
      function rejectedDeptFrom(d) {
        return (d.department != null) ? d.department : 'videography';
      }

      allow read: if signedIn() && (
        isSuperAdmin()
        || canManageDept(rejectedDeptFrom(resource.data))
        || (resource.data.userId == request.auth.uid)
      );
      allow create: if isDeptHead() && canManageDept(rejectedDeptFrom(request.resource.data));
      allow update, delete: if canManageDept(rejectedDeptFrom(resource.data));
    }

    match /mail/{id} {
      allow read: if false;
      allow create: if isDeptHead();
      allow update, delete: if false;
    }

    match /whatsapp/{id} {
      allow read: if false;
      allow create: if isDeptHead();
      allow update, delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
