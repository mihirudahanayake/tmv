rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSiteAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == 'mihirumilanka11@gmail.com';
    }

    function myUserDoc() {
      return signedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }

    function myRole() {
      if (isSiteAdmin()) return 'siteAdmin';
      return (myUserDoc().role != null)
        ? myUserDoc().role
        : (myUserDoc().userType == 'admin')
          ? 'departmentHead'
          : (myUserDoc().userType == 'superAdmin')
            ? 'superAdmin'
            : 'member';
    }

    function isSuperAdmin() {
      return signedIn() && myRole() == 'superAdmin';
    }

    function isDeptHead() {
      return signedIn() && myRole() == 'departmentHead';
    }

    function myDepartments() {
      return (myUserDoc().departments is list)
        ? myUserDoc().departments
        : (myUserDoc().department != null)
          ? [myUserDoc().department]
          : [];
    }

    function departmentsFromUserData(d) {
      return (d.departments is list)
        ? d.departments
        : (d.department != null)
          ? [d.department]
          : [];
    }

    function myManagedDepartments() {
      if (!isDeptHead()) return [];
      return (myUserDoc().managedDepartments is list && myUserDoc().managedDepartments.size() > 0)
        ? myUserDoc().managedDepartments
        : (myUserDoc().firstPriority != null)
          ? [myUserDoc().firstPriority]
          : ['videography'];
    }

    function workDept(res) {
      // Legacy fallback: missing department treated as videography
      return (res.data.department != null) ? res.data.department : 'videography';
    }

    function allowedWorkDepts() {
      // Keep in sync with src/constants/workDepartments.js
      return ['videography', 'photography', 'graphic_design', 'announcing', 'content_writing', 'editing'];
    }

    function isValidWorkDept(dept) {
      return dept != null && allowedWorkDepts().hasAny([dept]);
    }

    function isValidWorkDeptList(listVal) {
      return (listVal is list)
        && listVal.size() > 0
        && listVal.size() <= 10
        && listVal.hasOnly(allowedWorkDepts());
    }

    function canManageDept(dept) {
      return isDeptHead() && myManagedDepartments().hasAny([dept]);
    }

    function canReadUserDoc(targetUserId, targetData) {
      if (!signedIn()) return false;
      if (isSiteAdmin()) return true;
      if (isSuperAdmin()) return true;
      if (targetUserId == request.auth.uid) return true;

      // Department heads: only users inside their managed department(s)
      if (isDeptHead()) {
        return myManagedDepartments().hasAny(departmentsFromUserData(targetData));
      }

      // Members: users that share at least one work department
      return myDepartments().hasAny(departmentsFromUserData(targetData));
    }

    match /users/{userId} {
      allow read: if canReadUserDoc(userId, resource.data);

      // Site admin can manage roles/departments.
      allow update: if isSiteAdmin();

      // Department heads can create member profiles within their managed department.
      allow create: if isDeptHead()
        && request.resource.data.role == 'member'
        && request.resource.data.userType == 'user'
        && (request.resource.data.departments is list)
        && myManagedDepartments().hasAny(request.resource.data.departments);

      // Users can update their own profile but cannot change role or departments.
      allow update: if signedIn() && userId == request.auth.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.userType == resource.data.userType
        && request.resource.data.managedDepartments == resource.data.managedDepartments
        && (
          // Allow updating work departments, but only to known department values.
          (request.resource.data.departments == resource.data.departments)
          || isValidWorkDeptList(request.resource.data.departments)
        )
        && (
          (request.resource.data.firstPriority == resource.data.firstPriority)
          || request.resource.data.firstPriority == null
          || isValidWorkDept(request.resource.data.firstPriority)
        );

      // Department heads can update users in their managed department, but cannot grant elevated roles.
      allow update: if isDeptHead()
        && (resource.data.departments is list)
        && myManagedDepartments().hasAny(resource.data.departments)
        && request.resource.data.role == 'member'
        && request.resource.data.userType == 'user'
        && (request.resource.data.departments is list)
        && myManagedDepartments().hasAny(request.resource.data.departments);

      allow delete: if false;

      match /notifications/{notifId} {
        allow read: if signedIn() && userId == request.auth.uid;

        // Dept heads (and site admin) can create notifications for users they can read.
        allow create: if (isDeptHead() || isSiteAdmin()) && canReadUserDoc(
          userId,
          get(/databases/$(database)/documents/users/$(userId)).data
        );

        // Users can update their own (e.g., mark read).
        allow update: if signedIn() && userId == request.auth.uid;

        // Admins can edit the content of admin-sent notifications, but cannot change a user's read state.
        allow update: if (isDeptHead() || isSiteAdmin())
          && resource.data.source == 'admin'
          && resource.data.type == 'admin-message'
          && resource.data.broadcastId != null
          && request.resource.data.broadcastId == resource.data.broadcastId
          && request.resource.data.read == resource.data.read
          && (
            isSiteAdmin()
            || (resource.data.senderUid != null && resource.data.senderUid == request.auth.uid)
            || (resource.data.senderId != null && resource.data.senderId == request.auth.uid)
          )
          && canReadUserDoc(
            userId,
            get(/databases/$(database)/documents/users/$(userId)).data
          );
        // Allow deleting only admin-sent broadcast notifications.
        allow delete: if (isDeptHead() || isSiteAdmin())
          && resource.data.source == 'admin'
          && resource.data.type == 'admin-message'
          && resource.data.broadcastId != null
          && (
            isSiteAdmin()
            || (resource.data.senderUid != null && resource.data.senderUid == request.auth.uid)
          )
          && canReadUserDoc(
            userId,
            get(/databases/$(database)/documents/users/$(userId)).data
          );
      }
    }

    match /works/{workId} {
      allow read: if signedIn() && (
        isSuperAdmin()
        || canManageDept(workDept(resource))
        || ((resource.data.assignedUsers is list) && resource.data.assignedUsers.hasAny([request.auth.uid]))
      );

      allow create: if isDeptHead()
        && request.resource.data.department != null
        && canManageDept(request.resource.data.department);

      // Department heads can fully update works within their department.
      allow update, delete: if canManageDept(workDept(resource));

      // Assigned users can update limited fields (acceptance/completion/rejections) without changing assignment.
      allow update: if signedIn()
        && (resource.data.assignedUsers is list)
        && resource.data.assignedUsers.hasAny([request.auth.uid])
        && request.resource.data.title == resource.data.title
        && request.resource.data.description == resource.data.description
        && request.resource.data.department == resource.data.department
        && request.resource.data.assignedUsers == resource.data.assignedUsers
        && request.resource.data.assignedUserDetails == resource.data.assignedUserDetails
        && request.resource.data.assignedItems == resource.data.assignedItems
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.priority == resource.data.priority
        && request.resource.data.date == resource.data.date
        && request.resource.data.deadline == resource.data.deadline
        && request.resource.data.dateType == resource.data.dateType
        && request.resource.data.status == resource.data.status;
    }

    match /inventory/{itemId} {
      allow read: if signedIn();
      allow write: if isDeptHead();
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow write: if isDeptHead();
    }

    match /notifications/{notifId} {
      allow read: if isDeptHead() || isSuperAdmin();
      allow create: if signedIn();
      // Site admin can update/delete any notification.
      // Dept heads can:
      // - update/delete activity notifications in their managed departments
      // - update/delete admin-sent broadcasts only if they are the sender
      allow update, delete: if isSiteAdmin()
        || (
          isDeptHead()
          && (
            (
              // Activity notifications (received)
              resource.data.type != 'admin-message'
              && (
                resource.data.department == null
                || canManageDept(resource.data.department)
              )
            )
            || (
              // Admin-sent broadcasts
              resource.data.source == 'admin'
              && resource.data.type == 'admin-message'
              && (
                (resource.data.senderUid != null && resource.data.senderUid == request.auth.uid)
                || (resource.data.senderId != null && resource.data.senderId == request.auth.uid)
              )
              && (
                resource.data.department == null
                || canManageDept(resource.data.department)
              )
              && request.resource.data.department == resource.data.department
            )
          )
        );
    }

    match /rejectedWorks/{id} {
      function rejectedDeptFrom(d) {
        return (d.department != null) ? d.department : 'videography';
      }

      allow read: if signedIn() && (
        isSuperAdmin()
        || canManageDept(rejectedDeptFrom(resource.data))
        || (resource.data.userId == request.auth.uid)
      );
      allow create: if isDeptHead() && canManageDept(rejectedDeptFrom(request.resource.data));
      allow update, delete: if canManageDept(rejectedDeptFrom(resource.data));
    }

    match /mail/{id} {
      allow read: if false;
      allow create: if isDeptHead();
      allow update, delete: if false;
    }

    match /whatsapp/{id} {
      allow read: if false;
      allow create: if isDeptHead();
      allow update, delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
